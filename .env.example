# Required: Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Required on Render: your service URL (auto-set for web services)
RENDER_EXTERNAL_URL=https://your-app.onrender.com

# Optional: comma-separated admin Telegram user IDs
ADMIN_IDS=123456789,987654321

# Optional: database path (default: carwash.db)
# DB_PATH=carwash.db
